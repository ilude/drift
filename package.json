{
	"name": "drift",
	"version": "1.0.0",
	"description": "",
	"main": "src/main.ts",
	"packageManager": "bun@1.3.9",
	"engines": {
		"bun": ">=1.3.9",
		"node": ">=20"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"lint": "biome check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"typecheck": "bunx tsc --noEmit",
		"dead-code": "bunx knip",
		"clean": "node -e \"for (const p of ['dist','coverage']) require('node:fs').rmSync(p,{ recursive: true, force: true })\"",
		"verify:fast": "bun run lint && bun run typecheck",
		"verify": "bun run verify:fast && bun run test && bun run build",
		"ci": "bun run verify"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"type": "commonjs",
	"devDependencies": {
		"@biomejs/biome": "^2.4.8",
		"@types/three": "^0.183.1",
		"@vitest/coverage-v8": "^4.1.0",
		"jsdom": "^29.0.1",
		"knip": "^6.0.5",
		"typescript": "^5.9.3",
		"vite": "^8.0.1",
		"vitest": "^4.1.0"
	},
	"dependencies": {
		"three": "^0.183.2"
	}
}
